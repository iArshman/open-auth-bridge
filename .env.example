# OAuth Bridge Configuration
# Copy this file to .env and fill in your actual credentials

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft OAuth 2.0 Credentials
# Get these from: https://entra.microsoft.com/
MS_CLIENT_ID=your_microsoft_client_id_here
MS_CLIENT_SECRET=your_microsoft_client_secret_here

# Redirect URI
# This must match the redirect URI registered in both Google Cloud Console and Microsoft Entra
# Local: http://localhost:8000/callback
# Production: https://your-domain.com/callback

REDIRECT_URI=http://localhost:8000/callback
